# --- smart_llm: OpenAI-compatible chat (required in v1) ---
SMART_LLM_BASE_URL=https://api.deepseek.com/v1
SMART_LLM_API_KEY=
SMART_LLM_MODEL=deepseek-v4-flash
SMART_LLM_TIMEOUT=60

# --- image_llm: unified image backend ---
# backend: sd（本地）| cloud（云端，需 IMAGE_LLM_PROVIDER）| stub（占位）
IMAGE_LLM_BACKEND=sd
IMAGE_LLM_BASE_URL=http://127.0.0.1:9001
IMAGE_LLM_API_KEY=
IMAGE_LLM_MODEL=sd-cpp-local
IMAGE_LLM_TIMEOUT=300
IMAGE_LLM_CONNECT_TIMEOUT=15

# 云端示例（按次计费，生图不自动重试）：
# IMAGE_LLM_BACKEND=cloud
# IMAGE_LLM_PROVIDER=siliconflow
# IMAGE_LLM_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_LLM_API_KEY=<siliconflow key>
# IMAGE_LLM_MODEL=Qwen/Qwen-Image
#
# 智谱 glm-image（BASE_URL 是 v4 根路径，不是完整 generations 路径）：
# IMAGE_LLM_PROVIDER=zhipu
# IMAGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_LLM_API_KEY=<zhipu key>
# IMAGE_LLM_MODEL=glm-image
